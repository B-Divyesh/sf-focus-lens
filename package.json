{
  "name": "focus-lens",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config site/vite.config.ts",
    "dev:extension": "wxt",
    "build": "npm run build:site",
    "build:extension": "wxt build && node scripts/package-extension.mjs",
    "build:site": "node scripts/clean-dist.mjs && npm run build:extension && npm run build:web",
    "build:web": "vite build --config site/vite.config.ts",
    "test": "vitest run tests/settings.test.ts && playwright test",
    "test:unit": "vitest run tests/settings.test.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@types/chrome": "0.0.323",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4",
    "wxt": "0.20.11"
  }
}
