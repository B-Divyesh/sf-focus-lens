{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": ["chrome", "vitest/globals"],
    "skipLibCheck": true
  },
  "include": ["entrypoints", "lib", "site", "tests", "wxt.config.ts", ".wxt/**/*.d.ts"]
}
